{
  "name": "jetbrains-product-icon-theme",
  "displayName": "JetBrains New UI Product Icon Theme",
  "description": "JetBrains IDEs New UI inspired product icon theme. Minimize distractions and boost productivity",
  "publisher": "fogio",
  "version": "1.2.0",
  "license": "MIT",
  "homepage": "https://github.com/fogio-org/vscode-jetbrains-product-icon-theme",
  "bugs": {
    "url": "https://github.com/fogio-org/vscode-jetbrains-product-icon-theme/issues",
    "email": "nickitonov@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fogio-org/vscode-jetbrains-product-icon-theme.git"
  },
  "icon": "assets/img/icon.png",
  "engines": {
    "vscode": "^1.21.0"
  },
  "categories": [
    "Themes"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "keywords": [
    "jetbrains",
    "intellij",
    "pycharm",
    "goland",
    "rustrover",
    "webstorm",
    "idea",
    "clion",
    "phpstorm",
    "rubymiine",
    "appcode",
    "datagrip",
    "rider",
    "dataspell",
    "theme",
    "new ui",
    "cold",
    "dark",
    "material",
    "semantic",
    "python",
    "go",
    "golang"
  ],
  "contributes": {
    "productIconThemes": [
      {
        "id": "jetbrains-product-icon-theme",
        "label": "JetBrains New UI Product Icon Theme",
        "path": "./producticons/jetbrains-product-icon-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build-font.mjs",
    "preview": "node scripts/generate-preview.mjs",
    "validate:manifest": "node scripts/validate-manifest.js",
    "validate": "node scripts/validate-product-icons.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/codicons": "^0.0.45",
    "@vscode/vsce": "^3.0.0",
    "sharp": "^0.34.5",
    "svg-pathdata": "^9.0.0",
    "svg2ttf": "^6.0.3",
    "svgicons2svgfont": "^15.0.1",
    "ttf2woff2": "^6.0.1"
